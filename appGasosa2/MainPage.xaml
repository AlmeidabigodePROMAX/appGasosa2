<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appGasosa2.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Álcool ou Gasolina?"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#1565C0"
                HorizontalOptions="Center" />

            <Label
                Text="Dados do abastecimento"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#1565C0" />

            <Entry
                x:Name="txtAlcool"
                Placeholder="Preço do álcool (R$)"
                PlaceholderColor="#777777"
                TextColor="Black"
                Keyboard="Numeric" />

            <Entry
                x:Name="txtGasolina"
                Placeholder="Preço da gasolina (R$)"
                PlaceholderColor="#777777"
                TextColor="Black"
                Keyboard="Numeric" />

            <Entry
                x:Name="txtKmInicial"
                Placeholder="Quilometragem inicial (km)"
                PlaceholderColor="#777777"
                TextColor="Black"
                Keyboard="Numeric" />

            <Entry
                x:Name="txtKmFinal"
                Placeholder="Quilometragem final (km)"
                PlaceholderColor="#777777"
                TextColor="Black"
                Keyboard="Numeric" />

            <Entry
                x:Name="txtLitros"
                Placeholder="Litros abastecidos"
                PlaceholderColor="#777777"
                TextColor="Black"
                Keyboard="Numeric" />

            <Label
                Text="Consumo estimado do veículo"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#1565C0" />

            <Entry
                x:Name="txtConsumoAlcool"
                Placeholder="Consumo com álcool (km/L)"
                PlaceholderColor="#777777"
                TextColor="Black"
                Keyboard="Numeric" />

            <Entry
                x:Name="txtConsumoGasolina"
                Placeholder="Consumo com gasolina (km/L)"
                PlaceholderColor="#777777"
                TextColor="Black"
                Keyboard="Numeric" />

            <Button
                Text="CALCULAR"
                Clicked="OnCalcularClicked"
                BackgroundColor="#1565C0"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50" />

            <Button
                Text="LIMPAR"
                Clicked="OnLimparClicked"
                BackgroundColor="White"
                TextColor="#1565C0"
                BorderColor="#1565C0"
                BorderWidth="2"
                CornerRadius="10"
                HeightRequest="50" />

            <Border
                Stroke="#1565C0"
                StrokeThickness="2"
                Padding="15"
                BackgroundColor="#F5F9FF">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Resultados"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#1565C0" />

                    <Label
                        x:Name="lblDistancia"
                        Text="Distância percorrida: -"
                        TextColor="Black" />

                    <Label
                        x:Name="lblConsumo"
                        Text="Consumo calculado: -"
                        TextColor="Black" />

                    <Label
                        x:Name="lblCustoAlcool"
                        Text="Custo por km (álcool): -"
                        TextColor="Black" />

                    <Label
                        x:Name="lblCustoGasolina"
                        Text="Custo por km (gasolina): -"
                        TextColor="Black" />

                    <Label
                        x:Name="lblRegra70"
                        Text="Regra dos 70%: -"
                        TextColor="Black" />

                    <Label
                        x:Name="lblRecomendacao"
                        Text="Recomendação: -"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#1565C0"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
